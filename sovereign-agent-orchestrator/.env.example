APP_NAME=Sovereign Agent Orchestrator
API_HOST=0.0.0.0
API_PORT=8080
DATABASE_URL=sqlite:///./orchestrator.db
WORKSPACE_ROOT=./workspace

# Model serving. fake = deterministic stub (no server). llamaswap = OpenAI-compatible
# endpoint (llama-swap in front of llama.cpp, or vLLM).
MODEL_MODE=fake
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=
MODEL_REGISTRY_PATH=config/model_registry.yaml
EMBEDDING_MODEL_ALIAS=embedder
VISION_MODEL_ALIAS=vision
# Second-stage retrieval scoring with a cross-encoder. Empty disables it.
RERANK_MODEL_ALIAS=reranker
RERANK_OVERFETCH=4
# Qwen3.5/3.6 are thinking models; keep this false so `content` is the answer
# rather than an unfinished chain of thought. Raise LLM_MAX_TOKENS if enabling.
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=2048
# Fail verification when a job's answer is not backed by retrieved evidence.
REQUIRE_EVIDENCE=false
# Classify tasks with the `router` model instead of regex (regex is the fallback).
USE_MODEL_ROUTER=false
ROUTER_MODEL_ALIAS=router
# Drop retrieved chunks containing prompt-injection attempts instead of fencing them.
BLOCK_ON_INJECTION=false
# Outbound email. Leave SMTP_HOST empty to draft .eml files without sending
# (the default, and the right choice for an air-gapped deployment).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

RAG_URL=
MAX_ITERATIONS=3
MAX_TOOL_CALLS=12
JOB_TIMEOUT_SECONDS=120
TOOL_TIMEOUT_SECONDS=30
API_KEY=change-me-in-production
DEFAULT_TENANT_ID=default
DEFAULT_CLEARANCE=internal
API_ROLE=user
